# Google Places API (New). Replace with your own restricted key.
GOOGLE_PLACES_API_KEY=replace_with_your_google_places_api_key

# Request retry and timeout settings
LEADSUTRA_PLACES_TIMEOUT_SECONDS=15
LEADSUTRA_PLACES_MAX_ATTEMPTS=2
LEADSUTRA_PLACES_RETRY_DELAY_SECONDS=0.15

# Optional Google Maps browser fallback switches
LEADSUTRA_ENABLE_MAPS_BROWSER_FALLBACK=false
LEADSUTRA_MAPS_FALLBACK_ON_ZERO_RESULTS=false
